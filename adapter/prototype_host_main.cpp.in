void registerPrototypeVu1Programs();
void reportPrototypeVu1Programs();
static void summary() {
#ifndef PROTOTYPE_INTERPRETER_BOOTSTRAP
 reportPrototypeVu1Programs();
#endif
 for(size_t i=0;i<std::size(candidates);++i)if(counts[i].load())std::cerr<<"SDK_COUNT "<<candidates[i].name<<"="<<counts[i].load()<<"\n";
 std::cerr<<"PROBE_STOP_REQUEST\n";
}
template<PS2Runtime::RecompiledFunction Handler>
static void hostCall(uint8_t* ram,R5900Context* ctx,PS2Runtime* runtime) {
 const auto it=entries.find(ctx->pc);
 if(prototypeDiagnostics&&it!=entries.end()) {
  const auto i=it->second;const auto n=counts[i].fetch_add(1);
  if(n<2)std::cerr<<"SDK_CALL "<<candidates[i].name<<" a0="<<std::hex<<GPR_U32(ctx,4)<<" a1="<<GPR_U32(ctx,5)<<" ra="<<GPR_U32(ctx,31)<<std::dec<<"\n";
 }
 ctx->pc=GPR_U32(ctx,31);Handler(ram,ctx,runtime);
}
static PS2Runtime::RecompiledFunction resolve(std::string_view name) {
 static const std::unordered_map<std::string_view,PS2Runtime::RecompiledFunction> sys={
#define DECL(name) {#name,&hostCall<&ps2_syscalls::name>},
 PS2_SYSCALL_LIST(DECL)
#undef DECL
 };
 static const std::unordered_map<std::string_view,PS2Runtime::RecompiledFunction> stub={
#define DECL(name) {#name,&hostCall<&ps2_stubs::name>},
 PS2_STUB_LIST(DECL)
#undef DECL
 };
 auto n=ps2_runtime_calls::resolveSyscallName(name);if(!n.empty())return sys.at(n);
 n=ps2_runtime_calls::resolveStubName(name);if(!n.empty())return stub.at(n);
 if(name=="sceCdLayerSearchFile")return resolve("sceCdSearchFile");
 return nullptr;
}
static bool install(PS2Runtime* runtime,const char* mode) {
 if(std::strcmp(mode,"off")==0)return true;
 const bool sif=std::strcmp(mode,"sif")==0;if(!sif&&std::strcmp(mode,"sdk")!=0)return false;
 size_t installed=0;
 for(size_t i=0;i<std::size(candidates);++i) {
  const auto& c=candidates[i];std::string_view name(c.name);
  if(sif&&name.find("Sif")==std::string_view::npos)continue;
  // Graphics/VU/GS/math are the original prototype, not generic host stubs.
  if(name.find("Gs")!=std::string_view::npos||name.find("DmaGet")!=std::string_view::npos||name.find("DmaSend")!=std::string_view::npos||name.find("DmaRecv")!=std::string_view::npos||name.find("DmaSync")!=std::string_view::npos||name.find("DmaReset")!=std::string_view::npos||name.find("DmaPause")!=std::string_view::npos||name.find("DmaPutEnv")!=std::string_view::npos)continue;
  if(name.find("Mpeg")!=std::string_view::npos||name.find("Ipu")!=std::string_view::npos) {
   const char* ipu=std::getenv("PS2X_IPU");const char* hle=std::getenv("GODHAND_MPEG_HLE");
   if(!((ipu&&*ipu=='0')||(hle&&*hle=='1'))){std::cerr<<"SDK_ORIGINAL_IPU "<<name<<"\n";continue;}
  }
  const auto handler=resolve(name);if(!handler){std::cerr<<"SDK_UNBOUND "<<name<<"\n";continue;}
  if(!runtime->hasFunction(c.address)){std::cerr<<"SDK_NO_ENTRY "<<name<<"\n";return false;}
  entries[c.address]=i;if(!runtime->registerFunction(c.address,handler))return false;
  ++installed;std::cerr<<"SDK_BOUND "<<name<<" prototype="<<std::hex<<c.address<<std::dec<<"\n";
 }
 std::cerr<<"SDK_INSTALL mode="<<mode<<" count="<<installed<<"\n";return installed>0;
}



 if(!execution.valid()){std::cerr<<"PROTOTYPE_EXECUTION_REFUSED reason="<<godhand_pc::prototype_execution::errorName(execution.error)<<"\n";return 38;}
 prototypeDiagnostics=execution.kind!=godhand_pc::prototype_execution::Kind::Interactive;
 if(!prototypeDiagnostics){
  char** environment=initialEnvironment;if(!environment)return 38;
  for(char** p=environment;*p;++p){const std::string_view item(*p);const auto split=item.find('=');if(split==item.npos||split==0)continue;
   if(!godhand_pc::prototype_execution::allowedInteractiveVariable(item.substr(0,split),item.substr(split+1))){std::cerr<<"PROTOTYPE_EXECUTION_REFUSED environment_key="<<item.substr(0,split)<<"\n";return 38;}
  }
  if(envValue("PROTOTYPE_DEVELOPER_SHORTCUT")!="1"||envValue("PROTOTYPE_WINDOW_SHORTCUTS")!="edges-v1"||envValue("PROTOTYPE_MODULE_CONTROL")!="enabled"||envValue("PS2X_SIO2_PAD_STATUS")!="per-port-v1"||envValue("PS2X_FAKE_PADS")!="0")return 39;
 }
 const char* panelVersion=std::getenv("PROTOTYPE_DEV_PANEL");
 if(panelVersion&&*panelVersion&&std::strcmp(panelVersion,"controller-v1")!=0&&std::strcmp(panelVersion,"controller-v2")!=0)return 34;
 controllerPanelLeftStick=panelVersion&&std::strcmp(panelVersion,"controller-v2")==0;
 controllerPanelEnabled=controllerPanelLeftStick||(panelVersion&&std::strcmp(panelVersion,"controller-v1")==0);
 if(controllerPanelEnabled){
  const char* dev=std::getenv("PROTOTYPE_DEVELOPER_SHORTCUT");

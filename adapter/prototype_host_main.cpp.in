int main(int argc, char** argv,char** initialEnvironment) {
#ifdef PROTOTYPE_INTERPRETER_BOOTSTRAP
 if(const char* requested=std::getenv("PROTOTYPE_VU1_AOT");requested&&std::strcmp(requested,"1")==0){
  std::cerr<<"PROTOTYPE_BOOTSTRAP_REFUSED compiled_vu_requested=1 available=0\n";return 29;
 }
#endif

 if(argc==2&&std::strcmp(argv[1],"--module-api-test")==0)return moduleApiTest();
 if(argc!=5) { std::cerr<<"usage: prototype-probe original.elf original.bin private-output off|sif|sdk\n"; return 2; }
 const auto envValue=[](const char* key)->std::string_view{const char* p=std::getenv(key);return p?p:"";};

     "f9974f97a7c38a6f1d0fcdd66e0f9424bbe109ecca745493628b468d8ce5242e",godhand::Sha256{});
 if(!elfInput.verified()){
  std::cerr<<"PROTOTYPE_INPUT_REFUSED input=elf reason="<<godhand_pc::inputs::statusName(elfInput.status())<<" os_error="<<elfInput.osError()<<"\n";return 27;
 }

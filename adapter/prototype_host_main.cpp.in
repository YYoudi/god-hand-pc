 const char* aot=std::getenv("PROTOTYPE_VU1_AOT");
 if(aot && std::strcmp(aot,"0")!=0 && std::strcmp(aot,"1")!=0)return 17;
#ifndef PROTOTYPE_INTERPRETER_BOOTSTRAP
 if(aot && std::strcmp(aot,"1")==0){registerPrototypeVu1Programs();std::cerr<<"PROTOTYPE_VU1_AOT registered=5\n";}

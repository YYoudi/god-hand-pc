 std::cout<<"MODULE_API_TEST PASS replace/allocate/lookup/direct-call/remove; invented callback only, no game execution\n";return 0;
}


static std::filesystem::path developerInput;
static godhand_pc::prototype::DebugShortcut debugShortcut;
static std::filesystem::path developerRequests;
static std::streamoff developerRequestOffset=0;
static uint64_t developerProbeField=0;
static bool developerProbeDone=false;
static godhand_pc::prototype_controller::NativePanel controllerPanel;
static bool controllerPanelEnabled=false,controllerPanelLeftStick=false;
static bool queueDeveloperRequest(const char* source){
 if(controllerPanelEnabled&&(controllerPanel.faulted()||controllerPanel.busy(godhand_pc::prototype_controller::monotonicMs()))){std::cerr<<"PROTOTYPE_DEBUG_REQUEST source="<<source<<" accepted=0 panel_busy_or_fault=1\n";return false;}
 const bool accepted=debugShortcut.request(ps2_host_input::overlayOpen());
 std::cerr<<"PROTOTYPE_DEBUG_REQUEST source="<<source<<" accepted="<<accepted<<"\n";return accepted;
}
struct GLFWwindow;
using ObserverKeyCallback=void(*)(GLFWwindow*,int,int,int,int);
extern "C" GLFWwindow* glfwGetCurrentContext();
extern "C" ObserverKeyCallback glfwSetKeyCallback(GLFWwindow*,ObserverKeyCallback);
static ObserverKeyCallback priorKeyCallback=nullptr;
using ObserverFocusCallback=void(*)(GLFWwindow*,int);
extern "C" ObserverFocusCallback glfwSetWindowFocusCallback(GLFWwindow*,ObserverFocusCallback);
static ObserverFocusCallback priorFocusCallback=nullptr;
static PS2Runtime* keyTraceRuntime=nullptr;
static uint64_t keyTraceDrawSeq=0,keyTraceEventSeq=0,keyTraceLastEventUs=0;
static std::ofstream keyTraceFile;
static bool keyTraceEnabled(){static const bool on=[](){const char* p=std::getenv("PROTOTYPE_KEY_TRACE");return p&&std::strcmp(p,"events-v2")==0;}();return on;}
static uint64_t keyTraceUs(){return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());}
static uint64_t keyTraceUtcMs(){return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count());}
static bool keyTraceReadable(int k){return k>=0&&k<512;}
struct KeyTraceEvent{uint64_t seq,draw,us,utc,field;int kind,key,scan,action,mods,before,after,focus;std::thread::id thread;};
static std::array<KeyTraceEvent,256> keyTraceEvents{};
static size_t keyTraceCount=0,keyTraceDropped=0;
static void recordKeyTrace(int key,int scan,int action,int mods,int before,int kind=0){
 if(!keyTraceEnabled())return;
 const auto us=keyTraceUs();keyTraceLastEventUs=us;
 KeyTraceEvent e{++keyTraceEventSeq,keyTraceDrawSeq,us,keyTraceUtcMs(),keyTraceRuntime?keyTraceRuntime->eeScheduler().currentVSyncTick():0,kind,key,scan,action,mods,before,kind==0&&keyTraceReadable(key)?(IsKeyDown(key)?1:0):-2,IsWindowFocused()?1:0,std::this_thread::get_id()};
 if(keyTraceCount<keyTraceEvents.size())keyTraceEvents[keyTraceCount++]=e;else ++keyTraceDropped;
}
static void sampleKeyTrace(PS2Runtime& rt){
 if(!keyTraceEnabled())return;
 ++keyTraceDrawSeq;
 constexpr std::array<int,14> keys={KEY_DOWN,KEY_UP,KEY_K,KEY_L,KEY_ENTER,KEY_F1,KEY_F2,KEY_F3,KEY_KP_2,KEY_KP_8,KEY_KP_ENTER,KEY_LEFT_ALT,KEY_LEFT_CONTROL,KEY_RIGHT_CONTROL};
 std::array<int,28> values{};for(size_t n=0;n<keys.size();++n){values[n*2]=IsKeyDown(keys[n])?1:0;values[n*2+1]=IsKeyPressed(keys[n])?1:0;}
 static std::array<int,28> prior{};static bool initialized=false;
 const auto now=keyTraceUs();
 if(!initialized||values!=prior||keyTraceCount||keyTraceDropped||(keyTraceLastEventUs&&now-keyTraceLastEventUs<2000000u)||keyTraceDrawSeq%60==0){
  keyTraceFile<<"PROTOTYPE_INPUT_SAMPLE draw_seq="<<keyTraceDrawSeq<<" us="<<now<<" utc_ms="<<keyTraceUtcMs()<<" field="<<rt.eeScheduler().currentVSyncTick()<<" focus="<<IsWindowFocused()<<" overlay="<<ps2_host_input::overlayOpen()<<" levels=";
  for(size_t n=0;n<keys.size();++n)keyTraceFile<<keys[n]<<":"<<values[n*2]<<values[n*2+1]<<",";
  keyTraceFile<<" pending_events="<<keyTraceCount<<" dropped="<<keyTraceDropped<<" thread="<<std::this_thread::get_id()<<"\n";
 }
 initialized=true;prior=values;
 for(size_t n=0;n<keyTraceCount;++n){const auto& e=keyTraceEvents[n];
  keyTraceFile<<(e.kind==0?"PROTOTYPE_INPUT_EVENT":e.kind==1?"PROTOTYPE_INPUT_CHAR":"PROTOTYPE_INPUT_FOCUS")<<" seq="<<e.seq<<" draw_seq="<<e.draw<<" us="<<e.us<<" utc_ms="<<e.utc<<" field="<<e.field<<" key="<<e.key<<" scan="<<e.scan<<" action="<<e.action<<" mods="<<e.mods<<" before="<<e.before<<" after="<<e.after<<" focus="<<e.focus<<" thread="<<e.thread<<"\n";
 }
 keyTraceCount=0;keyTraceDropped=0;keyTraceFile.flush();
}
using ObserverCharCallback=void(*)(GLFWwindow*,unsigned int);
extern "C" ObserverCharCallback glfwSetCharCallback(GLFWwindow*,ObserverCharCallback);
static ObserverCharCallback priorCharCallback=nullptr;
static void observeTraceChar(GLFWwindow* w,unsigned int code){
 if(priorCharCallback)priorCharCallback(w,code);
 recordKeyTrace(static_cast<int>(code),-1,-1,0,-2,1);
}
static void observeDeveloperFocus(GLFWwindow* w,int focused){
 if(priorFocusCallback)priorFocusCallback(w,focused);
 if(!focused){prototype_window_keys::pending.clear();controllerPanel.clearPending();}
 std::cerr<<"PROTOTYPE_KEY_FOCUS_EVENT "<<focused<<"\n";
 recordKeyTrace(focused,-1,-1,0,-2,2);
}

static void observeDeveloperKey(GLFWwindow* w,int key,int scan,int action,int mods){
 if(key>=KEY_F1 && key<=KEY_F3)std::cerr<<"PROTOTYPE_KEY_EVENT key="<<key<<" scan="<<scan<<" action="<<action<<" mods="<<mods<<"\n";
 const int keyTraceBefore=(keyTraceEnabled()&&keyTraceReadable(key))?(IsKeyDown(key)?1:0):-1;
 if(priorKeyCallback)priorKeyCallback(w,key,scan,action,mods);
 recordKeyTrace(key,scan,action,mods,keyTraceBefore);
 if(prototype_window_keys::enabled()){
  using namespace godhand_pc::window_shortcuts;
  Key owned=Key::Count;
  if(key==KEY_F1)owned=Key::Controls;else if(key==KEY_F2)owned=Key::Developer;else if(key==KEY_ESCAPE)owned=Key::Back;
  if(owned!=Key::Count && action>=0 && action<=2)
   prototype_window_keys::pending.observe(owned,action==1?Action::Press:action==0?Action::Release:Action::Repeat,IsWindowFocused());
 }

}
static void developerShutdown(PS2Runtime&,void*){
 controllerPanel.shutdown();
 if(auto* w=glfwGetCurrentContext()){
  auto key=glfwSetKeyCallback(w,priorKeyCallback);if(key!=&observeDeveloperKey)glfwSetKeyCallback(w,key);
  auto focus=glfwSetWindowFocusCallback(w,priorFocusCallback);if(focus!=&observeDeveloperFocus)glfwSetWindowFocusCallback(w,focus);
  if(keyTraceEnabled()){auto chr=glfwSetCharCallback(w,priorCharCallback);if(chr!=&observeTraceChar)glfwSetCharCallback(w,chr);}
 }
 prototype_window_keys::pending.clear();
 keyTraceRuntime=nullptr;
}
static void developerInit(PS2Runtime& rt,void*){
 if(controllerPanelEnabled&&!controllerPanel.initialize(true,true,controllerPanelLeftStick?godhand_pc::prototype_controller::ControlSet::LeftStickV2:godhand_pc::prototype_controller::ControlSet::DigitalV1)){std::cerr<<"PROTOTYPE_CONTROLLER_INIT_REFUSED\n";std::_Exit(37);}
 keyTraceRuntime=&rt;if(auto* w=glfwGetCurrentContext()){priorKeyCallback=glfwSetKeyCallback(w,&observeDeveloperKey);priorFocusCallback=glfwSetWindowFocusCallback(w,&observeDeveloperFocus);if(keyTraceEnabled())priorCharCallback=glfwSetCharCallback(w,&observeTraceChar);std::cerr<<"PROTOTYPE_KEY_OBSERVER installed="<<(priorKeyCallback!=nullptr)<<"\n";}std::cerr<<"PROTOTYPE_F2_READY input chord bridge only; opening is not acknowledged\n";}
static void developerDraw(PS2Runtime& rt,void*){
 sampleKeyTrace(rt);
 static int oldFocus=-1;const int focus=IsWindowFocused();
 if(focus!=oldFocus){oldFocus=focus;std::cerr<<"PROTOTYPE_KEY_FOCUS "<<focus<<"\n";}
 for(int key=KEY_F1;key<=KEY_F3;++key)if(IsKeyPressed(key))std::cerr<<"PROTOTYPE_KEY_PRESSED "<<key<<"\n";

 const bool developerKey=prototype_window_keys::enabled()
  ? prototype_window_keys::pending.take(godhand_pc::window_shortcuts::Key::Developer,IsWindowFocused(),IsKeyPressed(KEY_F2))
  : IsKeyPressed(KEY_F2);
 if(developerKey){const bool accepted=queueDeveloperRequest("F2");if(accepted&&controllerPanelEnabled)controllerPanel.showFromF2();}
 if(!developerRequests.empty()){
  std::ifstream f(developerRequests,std::ios::binary);f.seekg(developerRequestOffset);
  std::string line;
  if(std::getline(f,line)){
   const auto at=f.tellg();if(at>=0)developerRequestOffset=at;
   if(line=="open-debug")queueDeveloperRequest("explicit-native-command");
   else std::cerr<<"PROTOTYPE_COMMAND_REFUSED unknown line\n";
  }
 }
 if(developerProbeField&&!developerProbeDone&&rt.eeScheduler().currentVSyncTick()>=developerProbeField){developerProbeDone=true;queueDeveloperRequest("explicit-native-probe");}
 const auto now=static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
 const auto prior=debugShortcut.phase();
 debugShortcut.tick(now,ps2_host_input::overlayOpen(),[](godhand_pc::prototype::Pulse pulse){
  const char* text=pulse==godhand_pc::prototype::Pulse::HoldL2?"l2:0.8\n":"r3:0.15\n";
  std::ofstream f(developerInput,std::ios::binary|std::ios::app);f.write(text,std::strlen(text));f.flush();
  const bool good=f.good();std::cerr<<"PROTOTYPE_DEBUG_PULSE "<<text<<" accepted="<<good<<"\n";return good;
 });
 if(debugShortcut.phase()!=prior)std::cerr<<"PROTOTYPE_DEBUG_PHASE "<<static_cast<int>(debugShortcut.phase())<<"\n";
 static unsigned priorButtons=~0u;static int priorConnected=-1;
 const auto pad=ps2_host_input::padState(0);
 if(pad.buttons!=priorButtons || int(pad.connected)!=priorConnected){priorButtons=pad.buttons;priorConnected=int(pad.connected);
  std::cerr<<"PROTOTYPE_HOST_PAD field="<<rt.eeScheduler().currentVSyncTick()<<" buttons="<<pad.buttons<<" connected="<<pad.connected<<"\n";
 }
 if(controllerPanelEnabled){
  if(debugShortcut.refusal()==godhand_pc::prototype::Refusal::WriterFailed)controllerPanel.writerFault();
  controllerPanel.tick(now,debugShortcut.active(),[](godhand_pc::prototype_controller::Action action){
   using namespace godhand_pc::prototype_controller;
   if(action==Action::OpenMenu)return queueDeveloperRequest("native-controller-panel")?Result::Submitted:Result::Refused;
   const auto text=pulse(action);if(text.empty())return Result::Refused;
   std::ofstream f(developerInput,std::ios::binary|std::ios::app);
   f.write(text.data(),static_cast<std::streamsize>(text.size()));f.flush();f.close();
   return f.good()?Result::Submitted:Result::UnknownDelivery;
  });
 }
 // The actual guest debug menu must be visible in later originals. No fake
 // 'menu opened' message, replacement scene, settings save or UI-thread guest call.
}


          "insert": "#include <string_view>\n"
        },
        {
          "start": 11440,
          "end": 11440,
          "insert": "        godhand_pc::sio2::PadBatchStatus padStatus;\n        const char *statusMode = std::getenv(\"PS2X_SIO2_PAD_STATUS\");\n        const char *legacyMode = std::getenv(\"PS2X_SIO2_RECV1\");\n        const bool statusEnabled = statusMode && std::string_view(statusMode)==\"per-port-v1\" &&\n                                   (!legacyMode || !*legacyMode || std::string_view(legacyMode)==\"0\");\n"
        },
        {
          "start": 12091,
          "end": 12091,
          "insert": ", statusEnabled ? &padStatus : nullptr"
        },
        {
          "start": 12178,
          "end": 12178,
          "insert": "        if(statusEnabled) {\n            if(const auto qualified=padStatus.result()) {\n                static unsigned logged=0;\n                if(logged++<16) {std::ostringstream msg;msg<<\"[SIO2] per-port-v1 old=0x\"<<std::hex<<recv1<<\" actual=0x\"<<*qualified;m_host.log(LogLevel::Info,msg.str());}\n                recv1=*qualified;\n            }\n        }\n"
        },
        {
          "start": 15680,
          "end": 15680,
          "insert": ", godhand_pc::sio2::PadBatchStatus *padStatus"
        },
        {
          "start": 19132,
          "end": 19132,
          "insert": "        if(padStatus) {\n            if(port<kPadPorts && !command.empty() && command[0]==0x01u)\n                padStatus->observe(port,acknowledged!=0u);\n            else padStatus->refuse(); // mixed/card/multitap keeps existing policy\n        }\n"
        }
      ]
    },
